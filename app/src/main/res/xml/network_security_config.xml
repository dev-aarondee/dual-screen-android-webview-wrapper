<?xml version="1.0" encoding="utf-8"?>
<!-- Allows http:// local dev servers (e.g. http://192.168.1.20:5173) as well as https:// production. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
